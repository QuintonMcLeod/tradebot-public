from __future__ import annotations
import logging
from typing import Optional


from tradebot_sci.market.models import MarketSnapshot
from tradebot_sci.strategy.decisions import AITradeDecision, close_position_decision
from tradebot_sci.strategy.variants.base import BaseStrategy
from tradebot_sci.market.indicators import calculate_ema, calculate_rsi
from tradebot_sci.strategy.icc_signals import calculate_atr
logger = logging.getLogger(__name__)

class ForexHybridReaperStrategy(BaseStrategy):
    score_threshold = 60.0
    SESSION_PROFILE = ["forex_hybrid_scalper:hybrid_overlap", "forex_hybrid_scalper:london_open", "forex_hybrid_scalper:asian_open"]
    """
    Forex Hybrid Reaper — regime-router.

    Strong HTF trend  -> trend-following pullback (ride the wave).
    Choppy / neutral  -> mean-reversion scalp.
    """
    def __init__(self, target_r=1.0, **kwargs):
        super().__init__("ForexHybridReaper")
        self.target_r = target_r
        self.score_threshold = float(kwargs.get('score_threshold', self.score_threshold))

        # Bollinger / RSI parameters
        self.bb_period = int(kwargs.get('bb_period', 20))
        self.bb_std = float(kwargs.get('bb_std', 1.5))
        self.rsi_period = int(kwargs.get('rsi_period', 7))
        self.rsi_overbought = float(kwargs.get('rsi_overbought', 60))
        self.rsi_oversold = float(kwargs.get('rsi_oversold', 40))

        # Trend filter
        self.trend_ema_period = int(kwargs.get('trend_ema', 200))

        # Regime switch: strong HTF trend vs neutral/chop
        self.trend_adx_min = float(kwargs.get('trend_adx_min', 20.0))

        # Trend-mode parameters (ride the wave)
        self.trend_stop_atr_mult = float(kwargs.get('trend_stop_atr_mult', 2.5))
        self.trend_stop_floor = float(kwargs.get('trend_stop_floor', 0.0020))
        self.trend_target_r = float(kwargs.get('trend_target_r', 4.0))
        self.trend_rsi_long_min = float(kwargs.get('trend_rsi_long_min', 40.0))
        self.trend_rsi_long_max = float(kwargs.get('trend_rsi_long_max', 55.0))
        self.trend_rsi_short_min = float(kwargs.get('trend_rsi_short_min', 45.0))
        self.trend_rsi_short_max = float(kwargs.get('trend_rsi_short_max', 60.0))
        # Floor-entry: only consider entries in the lower portion of the Bollinger
        # lower half (default 33%). This prevents buying the middle of the band after
        # a shallow hook.
        self.trend_entry_bb_percentile = float(kwargs.get('trend_entry_bb_percentile', 0.33))
        # Require a recent bar to have touched/pierced the outer Bollinger band before
        # a trend-mode entry, confirming the pullback reached the floor.
        self.trend_require_floor_touch = bool(kwargs.get('trend_require_floor_touch', True))
        # Require HTF and LTF to agree before trend-mode entries. This prevents the
        # strategy from taking trend-following entries when the lower timeframe is
        # still pointing the other way (chop / false pullback).
        self.trend_require_htf_ltf_align = bool(kwargs.get('trend_require_htf_ltf_align', True))
        # Optionally disable range-mode scalps entirely; focus only on clean trends.
        self.enable_range_mode = bool(kwargs.get('enable_range_mode', True))

        # Simulated limit-order entry for trend mode. Instead of buying the first
        # hook bar after a floor touch, we rest a synthetic limit at the Bollinger
        # floor and only enter if price revisits that level within N bars.
        self.trend_limit_order_enabled = bool(kwargs.get('trend_limit_order_enabled', True))
        self.trend_limit_order_expiry_bars = int(kwargs.get('trend_limit_order_expiry_bars', 3))
        self.trend_limit_order_offset_pct = float(kwargs.get('trend_limit_order_offset_pct', 0.0))

        # Require HTF direction to be stable for N bars before trend entries.
        # This filters one-bar ADX whipsaws that were flipping the bias.
        self.trend_htf_min_bars = int(kwargs.get('trend_htf_min_bars', 2))

        # Emergency diagnostic: invert the trend-mode entry direction. If the
        # strategy's fundamental read of the trend is inverted, this flag should
        # produce a positive-expectancy curve on the same setups.
        self.invert_trend_bias = bool(kwargs.get('invert_trend_bias', False))

        # Range-mode parameters (scalp)
        self.range_stop_atr_mult = float(kwargs.get('range_stop_atr_mult', 1.5))
        self.range_stop_floor = float(kwargs.get('range_stop_floor', 0.0008))
        self.range_target_r = float(kwargs.get('range_target_r', 1.0))

        # Shared filters
        self.price_hook_required = bool(kwargs.get('price_hook_required', True))
        self.rsi_hook_required = bool(kwargs.get('rsi_hook_required', True))

        # Pending simulated limit-order state, keyed by symbol so multi-symbol
        # runners do not share or corrupt one another's setup state.
        self._pending_limit_setup: dict[str, Optional[dict]] = {}

        # HTF direction history for stability filter, keyed by symbol.
        self._htf_dir_history: dict[str, list[str]] = {}

        logger.debug(
            f"Loaded ForexHybridReaper router trendADX>={self.trend_adx_min}"
        )

    def _price_hook(self, closes: list[float]) -> tuple[bool, bool]:
        if len(closes) < 2:
            return False, False
        return closes[-1] > closes[-2], closes[-1] < closes[-2]

    def _rsi_hook(self, closes: list[float]) -> tuple[bool, bool]:
        # Require period+2 closes so both current and previous RSI are real
        # Wilder-smoothed values. With only period+1 closes, calculate_rsi
        # returns the 50.0 fallback for the previous window, producing a false
        # hook whenever the current RSI differs from 50.
        if len(closes) < self.rsi_period + 2:
            return False, False
        cur = calculate_rsi(closes, self.rsi_period)
        prev = calculate_rsi(closes[:-1], self.rsi_period)
        if cur is None or prev is None:
            return False, False
        return cur > prev, cur < prev

    def _three_bar_pullback(self, closes: list[float], is_long: bool) -> bool:
        """True if the last 3 completed bars moved against the intended direction."""
        if len(closes) < 5:
            return False
        deltas = [closes[-i] - closes[-i-1] for i in range(2, 5)]
        if is_long:
            return all(d < 0 for d in deltas)
        return all(d > 0 for d in deltas)

    def _three_bar_exhaustion(self, closes: list[float], is_long: bool) -> bool:
        """True if the 3 bars before current are all against the setup (exhaustion).

        Range-mode entries need this exhaustion before the current bar hooks back.
        """
        if len(closes) < 5:
            return False
        deltas = [closes[-i-1] - closes[-i-2] for i in range(1, 4)]
        if is_long:
            return all(d < 0 for d in deltas)
        return all(d > 0 for d in deltas)

    def score_signal(self, snapshot: MarketSnapshot, gates: dict, regime: str | None = None,
                     setup_bias: str | None = None) -> tuple[float, str, str]:
        gates = gates or {}
        closes = [c.close for c in snapshot.candles]
        if len(closes) < self.trend_ema_period:
            return 0.0, "-", "HybridReaper: Insufficient data"

        last_close = closes[-1]
        trend_ema = calculate_ema(closes, self.trend_ema_period)

        exec_bollinger = gates.get("exec_bollinger", {})
        lower_bb = exec_bollinger.get("lower", float('-inf'))
        mid_bb = exec_bollinger.get("middle", last_close)
        upper_bb = exec_bollinger.get("upper", float('inf'))
        rsi = gates.get("exec_rsi", 50.0)

        htf_dir = str(gates.get("htf_dir", "neutral")).lower()
        ltf_dir = str(gates.get("ltf_dir", "neutral")).lower()

        if regime is None:
            htf_adx = gates.get("htf_adx", 0) or 0
            ltf_adx = gates.get("ltf_adx", 0) or 0
            adx = max(htf_adx, ltf_adx)
            regime = "trend" if (htf_dir in ("long", "short") and adx >= self.trend_adx_min) else "range"

        # Caller can pin the bias (used in range mode so the score reflects the
        # actual bounce direction instead of the slow-EMA direction).
        if setup_bias is not None:
            is_long_bias = setup_bias == "long"
        elif regime == "trend" and htf_dir in ("long", "short"):
            is_long_bias = (htf_dir == "long") ^ self.invert_trend_bias
        else:
            is_long_bias = last_close > trend_ema
        strat_bias = "long" if is_long_bias else "short"

        score = 0.0
        breakdown = []

        # 1. HTF/LTF alignment (40 pts) — LTF alignment is momentum confirmation
        # that the current bar is hooking back in the trend direction.
        if htf_dir == strat_bias:
            score += 20.0
            breakdown.append("HTF-Align(+20)")
        if ltf_dir == strat_bias:
            score += 20.0
            breakdown.append("LTF-Align(+20)")

        if regime == "trend":
            # 2. Graded Bollinger floor score (max 30 pts). Entries closer to the
            # outer Bollinger band get more points; entries near the top of the
            # allowed floor zone get fewer points. This prevents buying the middle
            # of the lower half after a shallow hook.
            bb_lower_half = max(mid_bb - lower_bb, 1e-12)
            bb_upper_half = max(upper_bb - mid_bb, 1e-12)
            long_floor_zone = lower_bb + self.trend_entry_bb_percentile * bb_lower_half
            short_floor_zone = upper_bb - self.trend_entry_bb_percentile * bb_upper_half
            if is_long_bias and lower_bb <= last_close <= long_floor_zone:
                zone_width = max(long_floor_zone - lower_bb, 1e-12)
                bb_score = 30.0 * (long_floor_zone - last_close) / zone_width
                score += bb_score
                breakdown.append(f"BB-Floor({bb_score:.0f})")
            elif not is_long_bias and short_floor_zone <= last_close <= upper_bb:
                zone_width = max(upper_bb - short_floor_zone, 1e-12)
                bb_score = 30.0 * (last_close - short_floor_zone) / zone_width
                score += bb_score
                breakdown.append(f"BB-Floor({bb_score:.0f})")

            # 3. RSI in healthy pullback zone (30 pts)
            if is_long_bias:
                if self.trend_rsi_long_min <= rsi <= self.trend_rsi_long_max:
                    score += 30.0
                    breakdown.append(f"RSI-Pullback({rsi:.1f}=+30)")
            else:
                if self.trend_rsi_short_min <= rsi <= self.trend_rsi_short_max:
                    score += 30.0
                    breakdown.append(f"RSI-Pullback({rsi:.1f}=+30)")
        else:
            # Range mode: close-pierce / bounce off outer band (30 pts)
            prev_close = closes[-2] if len(closes) >= 2 else last_close
            recent = snapshot.candles[-3:] if len(snapshot.candles) >= 3 else snapshot.candles
            if is_long_bias:
                if (prev_close <= lower_bb or any(c.low <= lower_bb for c in recent)) and last_close > lower_bb:
                    score += 30.0
                    breakdown.append("BB-Bounce(+30)")
            else:
                if (prev_close >= upper_bb or any(c.high >= upper_bb for c in recent)) and last_close < upper_bb:
                    score += 30.0
                    breakdown.append("BB-Bounce(+30)")

            # Range mode: RSI extreme (30 pts)
            overbought = float(getattr(self._profile, 'rsi_overbought', self.rsi_overbought)) if getattr(self, '_profile', None) else self.rsi_overbought
            oversold = float(getattr(self._profile, 'rsi_oversold', self.rsi_oversold)) if getattr(self, '_profile', None) else self.rsi_oversold
            if is_long_bias and rsi <= oversold:
                score += 30.0
                breakdown.append(f"RSI-OS({rsi:.1f}=+30)")
            if not is_long_bias and rsi >= overbought:
                score += 30.0
                breakdown.append(f"RSI-OB({rsi:.1f}=+30)")

        score = min(100.0, score)
        grade = self.grade_from_score_100(score)
        summary = f"HybridReaper[{regime}] {score:.0f}/100: {', '.join(breakdown)}"
        return score, grade, summary

    def _evaluate_pending_limit_setup(self, snapshot: MarketSnapshot, candles: list,
                                      htf_dir: str, ltf_dir: str) -> Optional[AITradeDecision]:
        """If a simulated limit order is pending, check for fill, expiry, or invalidation."""
        pending = self._pending_limit_setup.get(snapshot.symbol)
        if not pending:
            return None

        current_bar_idx = len(candles)
        side = pending["side"]
        limit_price = pending["limit_price"]
        candle = candles[-1]

        # Expiry
        if (current_bar_idx - pending["setup_bar_idx"]) > self.trend_limit_order_expiry_bars:
            logger.info(f"[HybridReaper] {snapshot.symbol} LIMIT EXPIRED: {side} @ {limit_price:.5f}")
            self._pending_limit_setup.pop(snapshot.symbol, None)
            return None

        # Invalidation only on HTF flip. The LTF is allowed to chop during the
        # pullback; cancelling on LTF noise killed too many good setups.
        opposite = "short" if side == "long" else "long"
        if htf_dir == opposite:
            logger.info(f"[HybridReaper] {snapshot.symbol} LIMIT CANCELLED: {side} due to HTF flip {htf_dir}")
            self._pending_limit_setup.pop(snapshot.symbol, None)
            return None

        # Fill check
        filled = False
        fill_price = None
        if side == "long" and candle.low <= limit_price:
            fill_price = min(limit_price, candle.close)
            filled = True
        elif side == "short" and candle.high >= limit_price:
            fill_price = max(limit_price, candle.close)
            filled = True

        if not filled:
            return None

        self._pending_limit_setup.pop(snapshot.symbol, None)
        entry_p = fill_price
        stop_dist = pending["stop_dist"]
        tr = pending["target_r"]
        rsi = pending["rsi"]
        score = pending["score"]

        if side == "long":
            stop_loss = entry_p - stop_dist
            target = entry_p + stop_dist * tr
            return AITradeDecision(
                symbol=snapshot.symbol, timeframe=snapshot.timeframe,
                bias="long", phase="continuation", action="enter_long",
                entry_price=entry_p, stop_loss=stop_loss, take_profit=target,
                risk_per_trade_pct=self.get_risk_pct(),
                structure_summary=f"HybridReaper Trend Long LIMIT FILL (RSI={rsi:.1f}, Score={score:.0f})",
                invalidation_conditions="Close below stop loss.",
                management_instructions=f"Trend mode. Target {tr}R.",
                urgency="high", strategy_name=self.name, regime="trend"
            )
        else:
            stop_loss = entry_p + stop_dist
            target = entry_p - stop_dist * tr
            return AITradeDecision(
                symbol=snapshot.symbol, timeframe=snapshot.timeframe,
                bias="short", phase="continuation", action="enter_short",
                entry_price=entry_p, stop_loss=stop_loss, take_profit=target,
                risk_per_trade_pct=self.get_risk_pct(),
                structure_summary=f"HybridReaper Trend Short LIMIT FILL (RSI={rsi:.1f}, Score={score:.0f})",
                invalidation_conditions="Close above stop loss.",
                management_instructions=f"Trend mode. Target {tr}R.",
                urgency="high", strategy_name=self.name, regime="trend"
            )

    def _create_pending_limit_setup(self, snapshot: MarketSnapshot, side: str,
                                    limit_price: float, stop_dist: float,
                                    target_r: float, rsi: float, score: float,
                                    setup_bar_idx: int) -> None:
        """Store a simulated limit order for a future bar."""
        self._pending_limit_setup[snapshot.symbol] = {
            "symbol": snapshot.symbol,
            "side": side,
            "limit_price": limit_price,
            "stop_dist": stop_dist,
            "target_r": target_r,
            "rsi": rsi,
            "score": score,
            "setup_bar_idx": setup_bar_idx,
        }
        logger.info(
            f"[HybridReaper] {snapshot.symbol} LIMIT PENDING: {side} @ {limit_price:.5f} "
            f"(expiry {self.trend_limit_order_expiry_bars} bars)"
        )

    def check_entry_signal(self, snapshot: MarketSnapshot, gates: dict, open_position: Optional[dict] = None, **kwargs) -> Optional[AITradeDecision]:
        if gates.get("is_synthetic_override") is True:
            return None

        candles = snapshot.candles
        if len(candles) < self.trend_ema_period or len(candles) < 40:
            return None

        # Volatility guard
        atr_history = [calculate_atr(candles[:i+1], period=14) for i in range(14, len(candles))]
        atr_history = [a for a in atr_history if a]
        if len(atr_history) < 20:
            return None
        avg_atr_20 = sum(atr_history[-20:]) / 20.0
        current_atr = calculate_atr(candles, period=14)
        if not current_atr or current_atr < (avg_atr_20 * 0.5):
            return None

        closes = [c.close for c in candles]
        trend_ema = calculate_ema(closes, self.trend_ema_period)
        last_close = closes[-1]

        htf_dir = str(gates.get("htf_dir", "neutral")).lower()
        ltf_dir = str(gates.get("ltf_dir", "neutral")).lower()
        htf_adx = gates.get("htf_adx", 0) or 0
        ltf_adx = gates.get("ltf_adx", 0) or 0
        adx = max(htf_adx, ltf_adx)

        exec_bollinger = gates.get("exec_bollinger", {})
        lower_bb = exec_bollinger.get("lower", float('-inf'))
        mid_bb = exec_bollinger.get("middle", last_close)
        upper_bb = exec_bollinger.get("upper", float('inf'))
        rsi = gates.get("exec_rsi", 50.0)

        # Track HTF direction history for stability filter, per symbol.
        self._htf_dir_history.setdefault(snapshot.symbol, []).append(htf_dir)
        if len(self._htf_dir_history[snapshot.symbol]) > max(self.trend_htf_min_bars, 10):
            self._htf_dir_history[snapshot.symbol].pop(0)

        # Regime routing
        # Trend only when HTF is clearly directional AND ADX confirms strength
        in_strong_trend = htf_dir in ("long", "short") and adx >= self.trend_adx_min
        regime = "trend" if in_strong_trend else "range"

        # Trend-mode entries follow the HTF direction. Range-mode entries take
        # their direction from the band that price actually bounced from, not
        # from the slow EMA — using the EMA in chop assigned long/short bias
        # opposite to the real mean-reversion setup.
        if regime == "trend" and htf_dir in ("long", "short"):
            is_long_setup = (htf_dir == "long") ^ self.invert_trend_bias
            setup_bias = "long" if is_long_setup else "short"
        else:
            prev_close = closes[-2] if len(closes) >= 2 else last_close
            recent = candles[-3:] if len(candles) >= 3 else candles
            touched_lower = prev_close <= lower_bb or any(c.low <= lower_bb for c in recent)
            touched_upper = prev_close >= upper_bb or any(c.high >= upper_bb for c in recent)
            overbought = float(getattr(self._profile, 'rsi_overbought', self.rsi_overbought)) if getattr(self, '_profile', None) else self.rsi_overbought
            oversold = float(getattr(self._profile, 'rsi_oversold', self.rsi_oversold)) if getattr(self, '_profile', None) else self.rsi_oversold

            if touched_lower and rsi <= oversold:
                setup_bias = "long"
                is_long_setup = True
            elif touched_upper and rsi >= overbought:
                setup_bias = "short"
                is_long_setup = False
            else:
                logger.info(f"[HybridReaper] {snapshot.symbol} BLOCKED: no valid range bounce")
                return None

        # In range mode, never fade a strong HTF trend. If HTF is strongly
        # directional but ADX is below threshold, stand aside.
        if not self.enable_range_mode and regime == "range":
            logger.info(f"[ForexHybridReaper] {snapshot.symbol} BLOCKED: range mode disabled")
            return None

        if regime == "range" and htf_dir in ("long", "short"):
            logger.info(f"[ForexHybridReaper] {snapshot.symbol} BLOCKED: range mode cannot fade HTF={htf_dir}")
            return None

        # Range mode should only trigger in genuinely low-ADX, sideways conditions.
        # High ADX with a neutral HTF direction means strong but conflicting momentum
        # (transition / chop) — exactly where mean-reversion scalps get run over.
        if regime == "range" and adx >= self.trend_adx_min:
            logger.info(f"[ForexHybridReaper] {snapshot.symbol} BLOCKED: range mode with high ADX={adx:.1f}")
            return None

        # If we are in a trade, clear any pending simulated order for this symbol.
        if open_position:
            if self._pending_limit_setup.get(snapshot.symbol):
                self._pending_limit_setup.pop(snapshot.symbol, None)
            return None

        # First, check for a fill on an existing simulated limit order (trend mode only).
        if self._pending_limit_setup.get(snapshot.symbol):
            return self._evaluate_pending_limit_setup(snapshot, candles, htf_dir, ltf_dir)

        score, grade, summary = self.score_signal(snapshot, gates, regime, setup_bias)

        logger.info(
            f"[HybridReaper Debug {snapshot.symbol}] Regime={regime} | Close={last_close:.5f} | "
            f"EMA={trend_ema:.5f} | RSI={rsi:.1f} | LBB={lower_bb:.5f} | UBB={upper_bb:.5f} | "
            f"HTF={htf_dir} | LTF={ltf_dir} | ADX={adx:.1f} | Score={score:.1f}"
        )

        price_long_hook, price_short_hook = self._price_hook(closes)
        rsi_long_hook, rsi_short_hook = self._rsi_hook(closes)

        if self.price_hook_required:
            if is_long_setup and not price_long_hook:
                logger.info(f"[HybridReaper] {snapshot.symbol} BLOCKED: no price long hook")
                return None
            if not is_long_setup and not price_short_hook:
                logger.info(f"[HybridReaper] {snapshot.symbol} BLOCKED: no price short hook")
                return None

        if self.rsi_hook_required:
            if is_long_setup and not rsi_long_hook:
                logger.info(f"[HybridReaper] {snapshot.symbol} BLOCKED: no RSI long hook")
                return None
            if not is_long_setup and not rsi_short_hook:
                logger.info(f"[HybridReaper] {snapshot.symbol} BLOCKED: no RSI short hook")
                return None

        if regime == "trend":
            # Trend mode: require HTF direction to be stable for N bars
            recent_htf = self._htf_dir_history[snapshot.symbol][-self.trend_htf_min_bars:]
            if len(recent_htf) < self.trend_htf_min_bars or any(d != htf_dir for d in recent_htf):
                logger.info(f"[HybridReaper] {snapshot.symbol} BLOCKED: HTF={htf_dir} not stable for {self.trend_htf_min_bars} bars")
                return None

            # Trend mode: require HTF/LTF alignment so we don't trade chop
            if self.trend_require_htf_ltf_align and htf_dir != ltf_dir:
                logger.info(f"[HybridReaper] {snapshot.symbol} BLOCKED: HTF={htf_dir} vs LTF={ltf_dir} not aligned")
                return None

            # Trend mode: 3-bar pullback completed, current bar hooks back
            if not self._three_bar_pullback(closes, is_long_setup):
                logger.info(f"[HybridReaper] {snapshot.symbol} BLOCKED: trend pullback not present")
                return None

            stop_dist = max(current_atr * self.trend_stop_atr_mult, last_close * self.trend_stop_floor)
            tr = self.trend_target_r
            recent_candles = candles[-3:] if len(candles) >= 3 else candles

            # Floor-entry: require price inside the tight floor zone and a recent
            # touch of the outer Bollinger band. This ensures we enter near the
            # actual floor rather than after a shallow hook in the middle of the band.
            recent_low = min(c.low for c in recent_candles)
            recent_high = max(c.high for c in recent_candles)
            touched_lower = recent_low <= lower_bb
            touched_upper = recent_high >= upper_bb
            long_floor_zone = lower_bb + self.trend_entry_bb_percentile * (mid_bb - lower_bb)
            short_floor_zone = upper_bb - self.trend_entry_bb_percentile * (upper_bb - mid_bb)

            # Decide whether to use a simulated limit order or an immediate market entry.
            use_limit = self.trend_limit_order_enabled
            current_candle = candles[-1]

            long_setup_ok = (is_long_setup and
                             self.trend_rsi_long_min <= rsi <= self.trend_rsi_long_max and
                             lower_bb <= last_close <= long_floor_zone and
                             (touched_lower or not self.trend_require_floor_touch) and
                             score >= self.score_threshold)

            short_setup_ok = (not is_long_setup and
                              self.trend_rsi_short_min <= rsi <= self.trend_rsi_short_max and
                              short_floor_zone <= last_close <= upper_bb and
                              (touched_upper or not self.trend_require_floor_touch) and
                              score >= self.score_threshold)

            if long_setup_ok:
                limit_price = lower_bb * (1.0 + self.trend_limit_order_offset_pct)
                if use_limit:
                    self._create_pending_limit_setup(
                        snapshot, "long", limit_price, stop_dist, tr, rsi, score, len(candles)
                    )
                    # If the current bar already trades through the limit, fill now.
                    if current_candle.low <= limit_price:
                        return self._evaluate_pending_limit_setup(snapshot, candles, htf_dir, ltf_dir)
                    return None

                stop_loss = last_close - stop_dist
                target = last_close + stop_dist * tr
                return AITradeDecision(
                    symbol=snapshot.symbol, timeframe=snapshot.timeframe,
                    bias="long", phase="continuation", action="enter_long",
                    entry_price=last_close, stop_loss=stop_loss, take_profit=target,
                    risk_per_trade_pct=self.get_risk_pct(),
                    structure_summary=f"HybridReaper Trend Long (RSI={rsi:.1f}, Floor, Score={score:.0f})",
                    invalidation_conditions="Close below stop loss.",
                    management_instructions=f"Trend mode. Target {tr}R.",
                    urgency="high", strategy_name=self.name, regime="trend"
                )

            if short_setup_ok:
                limit_price = upper_bb * (1.0 - self.trend_limit_order_offset_pct)
                if use_limit:
                    self._create_pending_limit_setup(
                        snapshot, "short", limit_price, stop_dist, tr, rsi, score, len(candles)
                    )
                    if current_candle.high >= limit_price:
                        return self._evaluate_pending_limit_setup(snapshot, candles, htf_dir, ltf_dir)
                    return None

                stop_loss = last_close + stop_dist
                target = last_close - stop_dist * tr
                return AITradeDecision(
                    symbol=snapshot.symbol, timeframe=snapshot.timeframe,
                    bias="short", phase="continuation", action="enter_short",
                    entry_price=last_close, stop_loss=stop_loss, take_profit=target,
                    risk_per_trade_pct=self.get_risk_pct(),
                    structure_summary=f"HybridReaper Trend Short (RSI={rsi:.1f}, Floor, Score={score:.0f})",
                    invalidation_conditions="Close above stop loss.",
                    management_instructions=f"Trend mode. Target {tr}R.",
                    urgency="high", strategy_name=self.name, regime="trend"
                )

        else:
            # Range mode: never enter against a strong HTF trend (blocked above).
            # Only scalp when HTF is neutral/mild.
            if not self._three_bar_exhaustion(closes, is_long_setup):
                logger.info(f"[HybridReaper] {snapshot.symbol} BLOCKED: no 3-bar exhaustion")
                return None

            stop_dist = max(current_atr * self.range_stop_atr_mult, last_close * self.range_stop_floor)
            tr = float(getattr(self._profile, "target_r", self.range_target_r)) if getattr(self, "_profile", None) else self.range_target_r

            # Range direction already resolved in setup_bias above.
            if (is_long_setup and
                score >= self.score_threshold):
                stop_loss = last_close - stop_dist
                target = last_close + stop_dist * tr
                return AITradeDecision(
                    symbol=snapshot.symbol, timeframe=snapshot.timeframe,
                    bias="long", phase="correction", action="enter_long",
                    entry_price=last_close, stop_loss=stop_loss, take_profit=target,
                    risk_per_trade_pct=self.get_risk_pct(),
                    structure_summary=f"HybridReaper Range Long (RSI={rsi:.1f}, Bounce, Score={score:.0f})",
                    invalidation_conditions="Close below stop loss.",
                    management_instructions=f"Range mode. Target {tr}R.",
                    urgency="high", strategy_name=self.name, regime="range"
                )

            if (not is_long_setup and
                score >= self.score_threshold):
                stop_loss = last_close + stop_dist
                target = last_close - stop_dist * tr
                return AITradeDecision(
                    symbol=snapshot.symbol, timeframe=snapshot.timeframe,
                    bias="short", phase="correction", action="enter_short",
                    entry_price=last_close, stop_loss=stop_loss, take_profit=target,
                    risk_per_trade_pct=self.get_risk_pct(),
                    structure_summary=f"HybridReaper Range Short (RSI={rsi:.1f}, Bounce, Score={score:.0f})",
                    invalidation_conditions="Close above stop loss.",
                    management_instructions=f"Range mode. Target {tr}R.",
                    urgency="high", strategy_name=self.name, regime="range"
                )

        return None

    def check_exit_signal(self, snapshot: MarketSnapshot, open_position: dict, gates: dict, **kwargs) -> Optional[AITradeDecision]:
        if not open_position:
            return None

        position_side = str(open_position.get("bias") or open_position.get("side") or "").lower()
        if position_side not in ("long", "short"):
            return None

        closes = [c.close for c in snapshot.candles]
        if len(closes) < 2:
            return None
        last_close = closes[-1]
        current_price = getattr(snapshot, "price", last_close)

        entry_price = float(open_position.get("entry_price", 0.0) or 0.0)
        stop_loss = open_position.get("stop_loss")
        take_profit = open_position.get("take_profit")
        regime = str(open_position.get("regime", "range")).lower()

        # Hard stop / target (belt-and-suspenders in case executor missed them).
        if position_side == "long":
            if stop_loss is not None and current_price <= stop_loss:
                return close_position_decision(
                    snapshot.symbol, snapshot.timeframe,
                    f"HybridReaper stop hit (long @ {entry_price:.5f}, current={current_price:.5f})",
                    emergency_exit=True
                )
            if take_profit is not None and current_price >= take_profit:
                return close_position_decision(
                    snapshot.symbol, snapshot.timeframe,
                    f"HybridReaper target hit (long @ {entry_price:.5f}, current={current_price:.5f})"
                )
        else:
            if stop_loss is not None and current_price >= stop_loss:
                return close_position_decision(
                    snapshot.symbol, snapshot.timeframe,
                    f"HybridReaper stop hit (short @ {entry_price:.5f}, current={current_price:.5f})",
                    emergency_exit=True
                )
            if take_profit is not None and current_price <= take_profit:
                return close_position_decision(
                    snapshot.symbol, snapshot.timeframe,
                    f"HybridReaper target hit (short @ {entry_price:.5f}, current={current_price:.5f})"
                )

        # Regime-based invalidation.
        htf_dir = str(gates.get("htf_dir", "neutral")).lower()
        exec_bollinger = gates.get("exec_bollinger", {})
        mid_bb = exec_bollinger.get("middle", last_close)

        if regime == "trend":
            # Trend position: exit if the HTF direction flips against us.
            if (position_side == "long" and htf_dir == "short") or (position_side == "short" and htf_dir == "long"):
                return close_position_decision(
                    snapshot.symbol, snapshot.timeframe,
                    f"HybridReaper trend invalidation: HTF flipped to {htf_dir}"
                )
        else:
            # Range position: exit if price reverts through the middle band or
            # reaches the opposite outer band.
            upper_bb = exec_bollinger.get("upper", float('inf'))
            lower_bb = exec_bollinger.get("lower", float('-inf'))
            if position_side == "long":
                if last_close < mid_bb:
                    return close_position_decision(
                        snapshot.symbol, snapshot.timeframe,
                        "HybridReaper range invalidation: long scalp crossed below mid-BB"
                    )
                if last_close >= upper_bb:
                    return close_position_decision(
                        snapshot.symbol, snapshot.timeframe,
                        "HybridReaper range target: long scalp reached upper band"
                    )
            else:
                if last_close > mid_bb:
                    return close_position_decision(
                        snapshot.symbol, snapshot.timeframe,
                        "HybridReaper range invalidation: short scalp crossed above mid-BB"
                    )
                if last_close <= lower_bb:
                    return close_position_decision(
                        snapshot.symbol, snapshot.timeframe,
                        "HybridReaper range target: short scalp reached lower band"
                    )

        return None
